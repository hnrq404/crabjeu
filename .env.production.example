# Copie para .env.production (NÃO versionar) e preencha.

# Domínio apontando (registro A) para o IP da VPS. Ex.: crabjeu.seudominio.com.br
DOMAIN=crabjeu.example.com

# Gere com: openssl rand -hex 24   (use só letras/números, vai dentro da URL do banco)
POSTGRES_PASSWORD=

# Gere com: openssl rand -hex 32
JWT_SECRET=

# Conta do educador criada na primeira subida (deixe a senha vazia para não criar).
EDUCATOR_USERNAME=educador
EDUCATOR_PASSWORD=

# Validade do login em horas (720 = 30 dias). Enquanto o token vale, o aluno entra offline.
JWT_EXPIRE_HOURS=720
